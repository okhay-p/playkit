{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "playkit-signaling",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-08",
  "workers_dev": true,
  "observability": {
    "enabled": false,
  },
  "vars": {
    "ALLOWED_ORIGINS": "http://127.0.0.1:4173,http://localhost:5173,http://127.0.0.1:5173",
    "ALLOW_LOCAL_ICE": "true",
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "Room",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Room"],
    },
  ],
  "env": {
    "production": {
      "vars": {
        "ALLOWED_ORIGINS": "",
        "ALLOW_LOCAL_ICE": "false",
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "ROOMS",
            "class_name": "Room",
          },
        ],
      },
      "migrations": [
        {
          "tag": "v1",
          "new_sqlite_classes": ["Room"],
        },
      ],
    },
  },
}
